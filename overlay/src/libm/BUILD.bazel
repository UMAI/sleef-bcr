load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load(":implementation_library.bzl", "implementation_library")

# Final library
config_setting(
    name = "x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

cc_library(
    name = "libm_x86_64",
    deps = [
        ":avx512f",
        ":avx512fnofma",
        ":dispavx",
        ":dispscalar",
        ":dispsse",
    ],
)

cc_library(
    name = "libm",
    hdrs = [":generate_sleef_header"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = select({
        ":x86_64": [":libm_x86_64"],
    }),
)

# Exposed header
genrule(
    name = "generate_sleef_header",
    srcs = [
        "sleeflibm_header.h.org.in",
        "sleeflibm_footer.h.org",
    ],
    outs = ["include/sleef.h"],
    cmd = """
sed \
    -e 's/@SLEEF_VERSION_MAJOR@/3/g' \
    -e 's/@SLEEF_VERSION_MINOR@/9/g' \
    -e 's/@SLEEF_VERSION_PATCH@/0/g' \
    -e '/^#cmakedefine/d' \
    $(location sleeflibm_header.h.org.in) > $(@D)/header

$(location :mkrename) - 1 1 double float int32_t int32_t __STDC__ \
  > $(@D)/dsp
$(location :mkrename) cinz_ 1 1 double float int32_t int32_t __STDC__ purec \
  > $(@D)/purec
$(location :mkrename) finz_ 1 1 double float int32_t int32_t __STDC__ purecfma \
  > $(@D)/purecfma
$(location :mkrename) - 2 4 __m128d __m128 __m128i __m128i __SSE2__ \
  > $(@D)/sse_generic
$(location :mkrename) cinz_ 2 4 __m128d __m128 __m128i __m128i __SSE2__ sse2 \
  > $(@D)/sse2
$(location :mkrename) cinz_ 2 4 __m128d __m128 __m128i __m128i __SSE2__ sse4 \
  > $(@D)/sse4
$(location :mkrename) finz_ 2 4 __m128d __m128 __m128i __m128i __SSE2__ avx2128 \
  > $(@D)/avx2128
$(location :mkrename) - 4 8 __m256d __m256 __m128i "struct { __m128i x, y; }" __AVX__ \
  > $(@D)/avx_generic
$(location :mkrename) cinz_ 4 8 __m256d __m256 __m128i "struct { __m128i x, y; }" __AVX__ avx \
  > $(@D)/avx
$(location :mkrename) finz_ 4 8 __m256d __m256 __m128i "struct { __m128i x, y; }" __AVX__ fma4 \
  > $(@D)/fma4
$(location :mkrename) finz_ 4 8 __m256d __m256 __m128i __m256i __AVX__ avx2 \
  > $(@D)/avx2
$(location :mkrename) - 8 16 __m512d __m512 __m256i __m512i __AVX512F__ \
  > $(@D)/avx512_generic
$(location :mkrename) finz_ 8 16 __m512d __m512 __m256i __m512i __AVX512F__ avx512f \
  > $(@D)/avx512f
$(location :mkrename) cinz_ 8 16 __m512d __m512 __m256i __m512i __AVX512F__ avx512fnofma \
  > $(@D)/avx512fnofma

cat $(@D)/header \
    $(@D)/dsp $(@D)/purec $(@D)/purecfma \
    $(@D)/sse_generic $(@D)/sse2 $(@D)/sse4 $(@D)/avx2128 \
    $(@D)/avx_generic $(@D)/avx $(@D)/fma4 $(@D)/avx2 \
    $(@D)/avx512_generic $(@D)/avx512f $(@D)/avx512fnofma \
    $(location sleeflibm_footer.h.org) > $@
    """,
    tools = [":mkrename"],
)

# Tools definition
cc_binary(
    name = "mkrename",
    srcs = [
        "funcproto.h",
        "mkrename.c",
    ],
)

cc_binary(
    name = "mkdisp",
    srcs = [
        "funcproto.h",
        "mkdisp.c",
    ],
)

cc_binary(
    name = "mkalias",
    srcs = [
        "funcproto.h",
        "mkalias.c",
    ],
)

# Common targets
cc_library(
    name = "rempitab",
    srcs = ["rempitab.c"],
    deps = ["//src/common:headers"],
)

filegroup(
    name = "simd_sources",
    srcs = [
        "sleefsimddp.c",
        "sleefsimdsp.c",
    ],
)

# Scalar dispatcher and instruction set implementations
cc_library(
    name = "dispscalar",
    srcs = [
        "dispatcher.h",
        ":generate_dispscalar",
        ":generate_sleef_header",
    ],
    includes = [
        ".",
        "include",
    ],
    deps = [
        ":purec_scalar",
        ":purecfma_scalar",
        "//src/common:headers",
    ],
)

filegroup(
    name = "dispscalar_headers",
    srcs = [":generate_renamedspscalar"],
)

genrule(
    name = "generate_renamedspscalar",
    outs = ["include/renamedspscalar.h"],
    cmd = "$(location :mkrename) - 1 1 > $@",
    tools = [":mkrename"],
)

genrule(
    name = "generate_dispscalar",
    srcs = [
        "dispscalar.c.org",
        "dispscalar_footer.c.org",
    ],
    outs = ["dispscalar.c"],
    cmd = """
$(location :mkdisp) 1 1 double float int32_t purec purecfma x > $(@D)/body
cat $(location dispscalar.c.org) $(@D)/body \
    $(location dispscalar_footer.c.org) > $@
    """,
    tools = [":mkdisp"],
)

implementation_library(
    name = "purec_scalar",
    mkrename_params = "cinz_ 1 1 purec",
)

implementation_library(
    name = "purecfma_scalar",
    copts = [
        "-mavx2",
        "-mfma",
    ],
    mkrename_params = "finz_ 1 1 purecfma",
)

# SSE dispatcher and instruction set implementations
cc_library(
    name = "dispsse",
    srcs = [
        "dispatcher.h",
        ":generate_dispsse",
        ":generate_sleef_header",
    ],
    copts = [
        "-msse2",
    ],
    includes = [
        ".",
        "include",
    ],
    local_defines = ["ENABLE_AVX2"],
    deps = [
        ":avx2128",
        ":sse2",
        ":sse4",
        "//src/common",
        "//src/common:headers",
    ],
)

genrule(
    name = "generate_dispsse",
    srcs = [
        "dispsse.c.org",
    ],
    outs = ["dispsse.c"],
    cmd = """
$(location :mkdisp) 2 4 __m128d __m128 __m128i sse2 sse4 avx2128 > $(@D)/body
cat $(location dispsse.c.org) $(@D)/body > $@
    """,
    tools = [":mkdisp"],
)

implementation_library(
    name = "sse2",
    copts = ["-msse2"],
    mkrename_params = "cinz_ 2 4 sse2",
)

implementation_library(
    name = "sse4",
    copts = ["-msse4.1"],
    mkrename_params = "cinz_ 2 4 sse4",
)

implementation_library(
    name = "avx2128",
    copts = [
        "-mavx2",
        "-mfma",
    ],
    mkrename_params = "finz_ 2 4 avx2128",
)

# AVX dispatcher and instruction set implementations
cc_library(
    name = "dispavx",
    srcs = [
        "dispatcher.h",
        ":generate_dispavx",
        ":generate_sleef_header",
    ],
    copts = [
        "-mavx",
    ],
    includes = [
        ".",
        "include",
    ],
    local_defines = [
        "ENABLE_FMA4",
        "ENABLE_AVX2",
    ],
    deps = [
        ":avx",
        ":avx2",
        ":fma4",
        "//src/common",
        "//src/common:headers",
    ],
)

genrule(
    name = "generate_dispavx",
    srcs = [
        "dispavx.c.org",
    ],
    outs = ["dispavx.c"],
    cmd = """
$(location :mkdisp) 4 8 __m256d __m256 __m128i avx fma4 avx2 > $(@D)/body
cat $(location dispavx.c.org) $(@D)/body > $@
    """,
    tools = [":mkdisp"],
)

implementation_library(
    name = "avx",
    copts = ["-mavx"],
    mkrename_params = "cinz_ 4 8 avx",
)

implementation_library(
    name = "fma4",
    copts = ["-mfma4"],
    mkrename_params = "finz_ 4 8 fma4",
)

implementation_library(
    name = "avx2",
    copts = [
        "-mavx2",
        "-mfma",
    ],
    mkrename_params = "finz_ 4 8 avx2",
)

# AVX512 implementations
genrule(
    name = "generate_alias_avx512f",
    outs = ["include/alias_avx512f.h"],
    cmd = """
$(location :mkalias) -16 __m512 __m512i e avx512f > $@
$(location :mkalias) 8 __m512d __m256i e avx512f >> $@
    """,
    tools = [":mkalias"],
)

implementation_library(
    name = "avx512f",
    additional_defines = ['ALIAS_NO_EXT_SUFFIX=\\"alias_avx512f.h\\"'],
    additional_srcs = [":generate_alias_avx512f"],
    copts = [
        "-mavx512f",
    ],
    mkrename_params = "finz_ 8 16 avx512f",
)

implementation_library(
    name = "avx512fnofma",
    copts = [
        "-mavx512f",
    ],
    mkrename_params = "cinz_ 8 16 avx512fnofma",
)
