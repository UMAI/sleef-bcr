load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "tester3_purec_scalar",
    srcs = ["tester3.c"],
    args = ["$(location hash_cinz.txt)"],
    copts = [
        "-ffp-contract=off",
        "-DSLEEF_USE_INTERNAL_SHA256=1",
        "-DATR=cinz_",
        "-DDPTYPE=double",
        "-DSPTYPE=float",
        "-DDPTYPESPEC=d1",
        "-DSPTYPESPEC=f1",
        "-DEXTSPEC=purec",
    ],
    data = ["hash_cinz.txt"],
    linkopts = ["-lm"],
    linkstatic = True,
    deps = [
        "//src/common:feature_main",
        "//src/common:psha2",
        "//src/common:testerutil",
        "//src/libm",
    ],
)

